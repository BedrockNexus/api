{
  "name": "bedrock-nexus-api",
  "version": "1.0.0",
  "description": "BedrockNexus API - Lightweight Hono backend",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/BedrockNexus/api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BedrockNexus/api.git"
  },
  "bugs": {
    "url": "https://github.com/BedrockNexus/api/issues"
  },
  "packageManager": "bun@1.3.6",
  "type": "module",
  "scripts": {
		"dev": "bun run --watch src/index.ts",
		"dev:worker": "bun run --watch src/worker.ts",
    "lint": "bun node_modules/@biomejs/biome/bin/biome check src tests",
    "lint:fix": "bun node_modules/@biomejs/biome/bin/biome check --write src tests",
		"start": "bun run src/index.ts",
		"start:worker": "bun run src/worker.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.31",
    "hono": "^4.12.25",
    "hono-rate-limiter": "^0.5.3",
    "ipaddr.js": "^2.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  }
}
