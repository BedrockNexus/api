{
  "name": "bedrock-nexus-api",
  "version": "1.0.0",
  "description": "BedrockNexus API - Lightweight Hono backend",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "lint": "bun node_modules/@biomejs/biome/bin/biome check src tests",
    "lint:fix": "bun node_modules/@biomejs/biome/bin/biome check --write src tests",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.25",
    "hono-rate-limiter": "^0.4.2",
    "ipaddr.js": "^2.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.21",
    "typescript": "^5.9.3"
  }
}
