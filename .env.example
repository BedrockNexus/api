PORT=3001

# Required in production. Set the same value as BEDROCKNEXUS_API_KEY in Convex.
API_SECRET_KEY=your-secret-key-here

# Browser origins allowed to call public endpoints.
CORS_ORIGINS=http://localhost:3000,https://bedrocknexus.com

# Enable only behind a trusted proxy that replaces forwarding headers.
TRUST_PROXY_HEADERS=true

# Per-minute in-memory limits for each API instance.
GENERAL_RATE_LIMIT=60
STATUS_RATE_LIMIT=30

# Maximum simultaneous Bedrock UDP status checks per API instance.
MAX_CONCURRENT_STATUS_CHECKS=25

# Validator worker only. Use the exact hostname from R2 signed URLs.
ARTIFACT_ALLOWED_HOSTS=your-bucket-id.r2.cloudflarestorage.com
